# Example environment variables for the backend
# Copy this file to `.env` in the `backend/` folder and fill in your keys.

# OpenRouter (recommended) — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: some users provide an OpenAI-compatible key via this name
# The code will use OPENROUTER_API_KEY first, then fallback to OPENAI_API_KEY
OPENAI_API_KEY=

# Timeouts (seconds)
EVAL_REQUEST_TIMEOUT_SECONDS=300
OCR_REQUEST_TIMEOUT_SECONDS=240

# Debug flags
DEBUG_OCR=false
